# Monorepo convenience — optional single file for local `pnpm` from repo root.
# Prefer per-app examples:
#
#   apps/demo-api/.env.example  → API (metrics/stress and/or Cloud AI)
#   apps/dashboard/.env.example → dashboard BFF
#
# Cloud AI split (recommended product shape):
#   Local API:  IJNUT_MODE=selfhost  (metrics + stress + STRESS_ALLOWLIST)
#   Cloud API:  IJNUT_MODE=cloud     (auth + AI memory + Bachs)
#   Dashboard:  OBSERVABILITY_API_URL=local
#               IJNUT_CLOUD_AI_URL=https://your-cloud-ai…
#               IJNUT_MODE=cloud

# --- minimal combined local template (all-in-one; selfhost AI) ---

# selfhost = BYO AI keys, no paywall; cloud = sign-in + quota + chat memory
IJNUT_MODE=selfhost
# Host-wide plan override: free (gated) or pro (unlock AI for everyone on this host)
IJNUT_PLAN=free
# Lifetime free Cloud AI messages per signed-in user (cloud + free only)
IJNUT_AI_FREE_LIMIT=3

# API listen port
PORT=3000
# Postgres — auth sessions, user plan/quota, chat memory
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/api_obs
# Redis — shortener cache / rate limits
REDIS_URL=redis://127.0.0.1:6379
# Service API key protecting /observability/* (dashboard BFF sends this; not for browsers)
OBSERVABILITY_SERVICE_KEY=replace-with-long-random-secret
# Dashboard → local metrics/stress API
OBSERVABILITY_API_URL=http://127.0.0.1:3000
# Optional: separate Cloud AI host (auth + gated AI + Bachs). Unset = same as OBSERVABILITY_API_URL
# IJNUT_CLOUD_AI_URL=https://your-cloud-ai-api.up.railway.app

# better-auth signing secret (openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
# Public origin of the dashboard (OAuth redirects + cookies)
BETTER_AUTH_URL=http://127.0.0.1:3001

# GitHub OAuth app credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Which LLM backend: gemini | cohere
AI_PROVIDER=gemini
# Google Gemini API key (selfhost / Cloud AI host)
GEMINI_API_KEY=
# COHERE_API_KEY=
# Bachs billing (Cloud AI): secret key, recurring product id, webhook HMAC secret
BACHS_API_KEY=
BACHS_PRODUCT_ID=
BACHS_WEBHOOK_SECRET=
