# Deployment mode: selfhost (default) | cloud (your hosted API — gate AI/stress)
IJNUT_MODE=selfhost
# Cloud plan override for the whole deployment: free | pro
IJNUT_PLAN=free
# Lifetime free AI messages per signed-in Cloud user (ignored when selfhost or pro)
IJNUT_AI_FREE_LIMIT=3

# Demo API
PORT=3000
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/api_obs
REDIS_URL=redis://127.0.0.1:6379
ADMIN_TOKEN=change-me
STRESS_MAX_CONNECTIONS=100
STRESS_MAX_DURATION_SEC=60
STRESS_RATE_LIMIT_PER_MIN=1
# Include `api` when stress targets the Compose service name
STRESS_ALLOWLIST=127.0.0.1,localhost,api
DEMO_PUBLIC_URL=http://127.0.0.1:3000

# Dashboard (TanStack Start on :3001)
# Guests can open metrics; BFF uses OBSERVABILITY_ADMIN_TOKEN (server-only).
# Self-host: http://127.0.0.1:3000
# Cloud try-it: set OBSERVABILITY_API_URL + IJNUT_PUBLIC_API_URL to your hosted API
OBSERVABILITY_API_URL=http://127.0.0.1:3000
IJNUT_PUBLIC_API_URL=http://127.0.0.1:3000
OBSERVABILITY_ADMIN_TOKEN=change-me
# Set true only when serving the dashboard over HTTPS
COOKIE_SECURE=false

# Auth (better-auth — same Postgres as demo-api)
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://127.0.0.1:3001
# Optional: AUTH_DATABASE_URL=postgres://…  (defaults to DATABASE_URL)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional password-reset email (dev logs the link if unset)
RESEND_API_KEY=
RESEND_FROM=IJNUT <onboarding@resend.dev>

# Demo authz / rate limit
DEMO_USER_API_KEY=demo-user
SHORTEN_RATE_LIMIT_PER_MIN=10

# Dashboard AI (Gemini — OpenAI-compatible; server-side only)
# Self-host: use your own key. Cloud: operator's key (gated by IJNUT_AI_FREE_LIMIT).
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash
