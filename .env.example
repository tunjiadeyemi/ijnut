# Deployment mode: selfhost (default) | cloud (your hosted API — gate AI/stress)
IJNUT_MODE=selfhost
# Cloud plan: free (quotas) | pro (higher limits; billing later)
IJNUT_PLAN=free
# Cloud free AI chats per UTC day (ignored when selfhost or pro)
IJNUT_AI_DAILY_LIMIT=5

# Demo API
PORT=3000
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/api_obs
REDIS_URL=redis://127.0.0.1:6379
ADMIN_TOKEN=change-me
STRESS_MAX_CONNECTIONS=100
STRESS_MAX_DURATION_SEC=60
STRESS_RATE_LIMIT_PER_MIN=1
# Include `api` when stress targets the Compose service name
STRESS_ALLOWLIST=127.0.0.1,localhost,api
DEMO_PUBLIC_URL=http://127.0.0.1:3000

# Dashboard (TanStack Start on :3001 — paste ADMIN_TOKEN in login UI)
# Self-host: http://127.0.0.1:3000
# Cloud try-it: set OBSERVABILITY_API_URL + IJNUT_PUBLIC_API_URL to your hosted API
# Compose dashboard overrides OBSERVABILITY_API_URL to http://api:3000
OBSERVABILITY_API_URL=http://127.0.0.1:3000
# Public URL for Demo stress targets (not docker-internal hostnames)
IJNUT_PUBLIC_API_URL=http://127.0.0.1:3000
OBSERVABILITY_ADMIN_TOKEN=change-me
# Set true only when serving the dashboard over HTTPS
COOKIE_SECURE=false

# Demo authz / rate limit
DEMO_USER_API_KEY=demo-user
SHORTEN_RATE_LIMIT_PER_MIN=10

# Dashboard AI (Gemini — OpenAI-compatible; server-side only)
# Self-host: use your own key. Cloud: operator's key (gated by IJNUT_AI_DAILY_LIMIT).
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash
