# Deployment mode: selfhost (default) | cloud (your hosted API — gate AI/stress)
IJNUT_MODE=selfhost
# Cloud plan override for the whole deployment: free | pro
IJNUT_PLAN=free
# Lifetime free AI messages per signed-in Cloud user (ignored when selfhost or pro)
IJNUT_AI_FREE_LIMIT=3

# Demo API (owns Postgres, better-auth, Gemini, billing user rows)
PORT=3000
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/api_obs
REDIS_URL=redis://127.0.0.1:6379
ADMIN_TOKEN=change-me
STRESS_MAX_CONNECTIONS=100
STRESS_MAX_DURATION_SEC=60
STRESS_RATE_LIMIT_PER_MIN=1
# Include `api` when stress targets the Compose service name
STRESS_ALLOWLIST=127.0.0.1,localhost,api
DEMO_PUBLIC_URL=http://127.0.0.1:3000

# Dashboard (TanStack Start on :3001) — BFF only, no direct Postgres
# Proxies /api/auth/* → API; metrics/AI/billing via OBSERVABILITY_API_URL + ADMIN_TOKEN
OBSERVABILITY_API_URL=http://127.0.0.1:3000
IJNUT_PUBLIC_API_URL=http://127.0.0.1:3000
OBSERVABILITY_ADMIN_TOKEN=change-me
# Set true only when serving the dashboard over HTTPS
COOKIE_SECURE=false

# Auth (better-auth runs on demo-api; BETTER_AUTH_URL is the public dashboard origin)
# OAuth callback: {BETTER_AUTH_URL}/api/auth/callback/github → dashboard proxies → API
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://127.0.0.1:3001
# Optional: AUTH_DATABASE_URL=postgres://…  (defaults to DATABASE_URL on the API)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional password-reset email (dev logs the link if unset)
RESEND_API_KEY=
RESEND_FROM=IJNUT <onboarding@resend.dev>

# Bachs (Cloud Pro — webhook hits dashboard, which updates users via the API)
# https://bachs.io — docs: https://docs.bachs.io
BACHS_SECRET_KEY=
# Alias accepted: BACHS_API_KEY=
BACHS_PRODUCT_ID=
BACHS_WEBHOOK_SECRET=

# Demo authz / rate limit
DEMO_USER_API_KEY=demo-user
SHORTEN_RATE_LIMIT_PER_MIN=10

# AI (Gemini) — demo-api only
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash
