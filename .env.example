# Monorepo convenience — optional single file for local `pnpm` from repo root.
# Prefer per-app examples (what each Railway service needs):
#
#   apps/demo-api/.env.example  → API (auth, DB, Gemini, Bachs, ADMIN_TOKEN)
#   apps/dashboard/.env.example → dashboard BFF (API URL + OBSERVABILITY_ADMIN_TOKEN)
#
# BETTER_AUTH_SECRET → API only (signs sessions). Not the same role as ADMIN_TOKEN.
# ADMIN_TOKEN (API) must equal OBSERVABILITY_ADMIN_TOKEN (dashboard).

# --- minimal combined local template ---
IJNUT_MODE=cloud
IJNUT_PLAN=free
IJNUT_AI_FREE_LIMIT=3

PORT=3000
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/api_obs
REDIS_URL=redis://127.0.0.1:6379
ADMIN_TOKEN=replace-with-long-random-secret
OBSERVABILITY_ADMIN_TOKEN=replace-with-long-random-secret
OBSERVABILITY_API_URL=http://127.0.0.1:3000
IJNUT_PUBLIC_API_URL=http://127.0.0.1:3000

BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://127.0.0.1:3001

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AI_PROVIDER=gemini
GEMINI_API_KEY=
# COHERE_API_KEY=
BACHS_API_KEY=
BACHS_PRODUCT_ID=
BACHS_WEBHOOK_SECRET=
