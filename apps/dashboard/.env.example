# dashboard — copy to apps/dashboard/.env (or set on Railway dashboard service)
# BFF only: no Postgres, no Gemini, no Bachs secrets

# Bearer key for the local metrics/stress API — must match that API's OBSERVABILITY_SERVICE_KEY
OBSERVABILITY_SERVICE_KEY=replace-with-long-random-secret
# Base URL of the local observability API (overview, requests, stress, suggested target)
OBSERVABILITY_API_URL=http://127.0.0.1:3000

# Cloud AI sidecar (optional). Auth + gated AI + chat memory + Bachs live here.
# Leave unset to use the same host as OBSERVABILITY_API_URL (full self-host).
# IJNUT_CLOUD_AI_URL=https://your-cloud-ai-api.up.railway.app
# Service key for Cloud AI when it differs from OBSERVABILITY_SERVICE_KEY (falls back to that key)
# IJNUT_CLOUD_AI_SERVICE_KEY=

# cloud = paywalled Cloud AI UI/hints; selfhost = BYO keys on the AI host (unlimited)
IJNUT_MODE=selfhost
# UI / gating hint: free or pro (authoritative plan checks run on the AI host)
IJNUT_PLAN=free
# Free-tier message limit shown in the UI (must match AI host IJNUT_AI_FREE_LIMIT)
IJNUT_AI_FREE_LIMIT=3

# Public origin of THIS app (OAuth callback host + proxy Host headers)
BETTER_AUTH_URL=http://127.0.0.1:3001
# Public HTTPS dashboard URL in production (OAuth / trusted origin)
# IJNUT_PUBLIC_DASHBOARD_URL=https://your-dashboard.up.railway.app

# Secure cookies — set true only when serving over HTTPS
COOKIE_SECURE=false

# Do NOT put on the dashboard:
# DATABASE_URL, BETTER_AUTH_SECRET, GEMINI_*, BACHS_*, GITHUB_CLIENT_SECRET, RESEND_*
