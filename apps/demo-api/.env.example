# demo-api — copy to apps/demo-api/.env (or set on Railway API service)
#
# Two roles for the same binary:
# 1) Local observability API — metrics, stress, shortener (IJNUT_MODE=selfhost)
# 2) Cloud AI sidecar — auth, gated AI + memory, Bachs (IJNUT_MODE=cloud)

PORT=3000

# selfhost = BYO AI keys, no paywall (local metrics API)
# cloud = AI requires sign-in + quota + persisted chat memory
IJNUT_MODE=selfhost
IJNUT_PLAN=free
IJNUT_AI_FREE_LIMIT=3

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/api_obs
# Optional override: AUTH_DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379

# Service key — must match dashboard OBSERVABILITY_ADMIN_TOKEN
# (or IJNUT_CLOUD_AI_ADMIN_TOKEN when this host is the Cloud AI sidecar)
ADMIN_TOKEN=replace-with-long-random-secret

# better-auth (Cloud AI / sign-in). openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
# Public dashboard origin (OAuth redirect + cookie Host via BFF)
BETTER_AUTH_URL=http://127.0.0.1:3001
# IJNUT_PUBLIC_DASHBOARD_URL=https://your-dashboard.up.railway.app
# BETTER_AUTH_TRUSTED_ORIGINS=https://your-dashboard.up.railway.app

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_FROM=IJNUT <onboarding@resend.dev>

# AI — pick one provider (or set AI_PROVIDER explicitly)
# AI_PROVIDER=gemini | cohere  (default: gemini if key set, else cohere)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash
# Cohere: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
# Alias: CO_API_KEY=
COHERE_MODEL=command-a-03-2025
# COHERE_BASE_URL=https://api.cohere.com

# Bachs — Cloud AI billing only (webhook: https://<this-api>/api/bachs/webhook)
# Product must be recurring with a USD price (NGN subs are not enabled).
BACHS_API_KEY=
# Alias: BACHS_SECRET_KEY=
BACHS_PRODUCT_ID=
BACHS_WEBHOOK_SECRET=
# BACHS_RETURN_URL=https://your-dashboard.up.railway.app

# Stress runs on THIS process — allowlist hosts you own
STRESS_ALLOWLIST=127.0.0.1,localhost,api
STRESS_MAX_CONNECTIONS=100
STRESS_MAX_DURATION_SEC=60
STRESS_RATE_LIMIT_PER_MIN=1
DEMO_PUBLIC_URL=http://127.0.0.1:3000
DEMO_USER_API_KEY=demo-user
SHORTEN_RATE_LIMIT_PER_MIN=10
