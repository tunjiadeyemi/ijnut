# demo-api — copy to apps/demo-api/.env (or set on Railway API service)
#
# Two roles for the same binary:
# 1) Local observability API — metrics, stress, shortener (IJNUT_MODE=selfhost)
# 2) Cloud AI sidecar — auth, gated AI + memory, Bachs (IJNUT_MODE=cloud)

# API listen port
PORT=3000

# selfhost = BYO AI keys, no paywall (local metrics API)
# cloud = AI requires sign-in + quota + persisted chat memory
IJNUT_MODE=selfhost
# Host-wide plan override: free (per-user quota) or pro (unlock AI for everyone on this host)
IJNUT_PLAN=free
# Lifetime free Cloud AI messages per signed-in user (cloud + free only)
IJNUT_AI_FREE_LIMIT=3
# Max AI chat / new-conversation requests per minute (per session or IP)
AI_RATE_LIMIT_PER_MIN=30

# Postgres — auth sessions, user plan/quota, chat memory
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/api_obs
# Optional separate DB for auth/quota if you split stores
# AUTH_DATABASE_URL=
# Redis — shortener cache / rate limits
REDIS_URL=redis://127.0.0.1:6379

# Service API key protecting metrics/stress /observability/* (dashboard OBSERVABILITY_SERVICE_KEY).
# On a Cloud AI host (IJNUT_MODE=cloud), AI + billing also accept login-only (no key) for customers.
OBSERVABILITY_SERVICE_KEY=replace-with-long-random-secret
# Legacy alias: ADMIN_TOKEN=

# better-auth signing secret (Cloud AI / sign-in). openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
# Public dashboard origin (OAuth redirect + cookie Host via BFF)
BETTER_AUTH_URL=http://127.0.0.1:3001
# Public HTTPS dashboard URL (prod OAuth / Bachs return host allowlist)
# IJNUT_PUBLIC_DASHBOARD_URL=https://your-dashboard.up.railway.app
# Extra allowed dashboard origins (comma-separated)
# BETTER_AUTH_TRUSTED_ORIGINS=https://your-dashboard.up.railway.app

# GitHub OAuth app credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Resend — email magic-link / transactional from address
RESEND_API_KEY=
RESEND_FROM=IJNUT <onboarding@resend.dev>

# AI — pick one provider (or set AI_PROVIDER explicitly)
# AI_PROVIDER=gemini | cohere  (default: gemini if key set, else cohere)
AI_PROVIDER=gemini
# Google Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash
# Cohere: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
# Alias: CO_API_KEY=
COHERE_MODEL=command-a-03-2025
# COHERE_BASE_URL=https://api.cohere.com

# Bachs — Cloud AI billing only (webhook: https://<this-api>/api/bachs/webhook)
# Product must be recurring with a USD price (NGN subs are not enabled).
# Secret API key (alias: BACHS_SECRET_KEY)
BACHS_API_KEY=
# Recurring product id to sell at checkout
BACHS_PRODUCT_ID=
# HMAC secret to verify Bachs webhooks
BACHS_WEBHOOK_SECRET=
# Public dashboard fallback for Bachs success/cancel when returnOrigin is not sent
# BACHS_RETURN_URL=https://your-dashboard.up.railway.app

# Stress runs on THIS process — comma-separated hosts the stress tool may hit (SSRF guard)
STRESS_ALLOWLIST=127.0.0.1,localhost,api
# Max parallel virtual users per stress run
STRESS_MAX_CONNECTIONS=100
# Max stress duration in seconds
STRESS_MAX_DURATION_SEC=60
# Stress endpoint rate limit (requests per minute)
STRESS_RATE_LIMIT_PER_MIN=10
# Public origin of THIS API (short links + Bachs → localhost bounce). Cloud AI host must be https public.
DEMO_PUBLIC_URL=http://127.0.0.1:3000
# Demo shortener user API key
DEMO_USER_API_KEY=demo-user
# Shorten endpoint rate limit (requests per minute)
SHORTEN_RATE_LIMIT_PER_MIN=10
