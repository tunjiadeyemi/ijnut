{
  "name": "api-observability-lite",
  "private": true,
  "packageManager": "pnpm@9.14.2",
  "scripts": {
    "dev": "turbo run dev --filter=demo-api --filter=dashboard",
    "dev:api": "turbo run dev --filter=demo-api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "docker:up": "docker compose up -d postgres redis",
    "docker:stack": "docker compose up -d --build",
    "docker:down": "docker compose down"
  },

  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
